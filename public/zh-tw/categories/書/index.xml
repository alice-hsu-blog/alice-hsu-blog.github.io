&lt;div class=&#34;masonry-gallery&#34; 
     id=&#34;masonry-7843de418dbf2bd1cb7bb8ffe3332981-1&#34;
     data-columns=&#34;2&#34;
     data-gutter=&#34;10&#34;
     data-animate=&#34;true&#34;
     data-use-transform=&#34;true&#34;
